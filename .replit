# Команда, яка виконується при натисканні на кнопку "Run"
run = "npm run dev"
modules = ["nodejs-20"]

# Секція для системних пакетів. Залишаємо тільки те, що потрібно.
[nix]
channel = "stable-24_05"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 24678
externalPort = 3001
